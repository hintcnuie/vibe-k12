    {
      "template": "glyph",
      "pad": 0.85,
      "narration": "甲骨文的「雪」，「雨」字头下面是两只手。这个字的意思是，雪是凝结的雨，可以用手来捧住。",
      "props": {
        "era": "甲骨文",
        "glyph": "xuejiagu",
        "tone": "var(--teal)",
